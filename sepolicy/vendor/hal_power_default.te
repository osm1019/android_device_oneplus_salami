# ADPF must cross MCS categories on app processes (e.g. platform_app:s0:cXXX).
# Without mlstrustedsubject, appdomain setsched allows still AVCs on labeled apps.
typeattribute hal_power_default mlstrustedsubject;

# The lineage-libperfmgr power HAL connects to the thermal HAL to drive
# thermal-aware ADPF (ThermalStateListener → IThermal/default).
#
# Do NOT use a raw:
#   allow … hal_thermal_service:service_manager find;
# That violates the platform neverallow in system/sepolicy/private/hal_thermal.te
# (hal_attribute_service). Clients must use:
hal_client_domain(hal_power_default, hal_thermal)

# ADPF worker threads (adpf_handler0) renice/set scheduling on app threads.
# Matches hardware/google/pixel-sepolicy/power-libperfmgr/hal_power_default.te.
allow hal_power_default self:capability sys_nice;
allow hal_power_default appdomain:process { getsched setsched };
allow hal_power_default surfaceflinger:process setsched;
allow hal_power_default hal_graphics_composer_default:process setsched;
allow hal_power_default system_server:process setsched;
